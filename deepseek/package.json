{
  "name": "dsh-agent-bridge",
  "version": "1.0.3-local.3",
  "displayName": "Agent Bridge — DeepSeek版",
  "description": "Bidirectional task bridge between DeepSeek Harness and Codex: loopback HTTP endpoints for Codex-side MCP tools, and codex_task/codex_result tools for DSH agents.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-256.png"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "assets",
    "MANUAL.md",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codex",
    "bridge",
    "collaboration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
